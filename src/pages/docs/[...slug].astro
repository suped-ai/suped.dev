---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[i - 1] ?? null, next: docs[i + 1] ?? null, all: docs },
  }));
}

const { entry, prev, next, all } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="docs">
    <nav class="docs-nav" aria-label="Docs">
      <div class="label">docs</div>
      <ol>
        {all.map((d) => (
          <li>
            <a href={`/docs/${d.id}`} aria-current={d.id === entry.id ? 'page' : undefined}>{d.data.title}</a>
          </li>
        ))}
      </ol>
    </nav>
    <article class="docs-main">
      <div class="prose">
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="description">{entry.data.description}</p>}
        <Content />
      </div>
      <div class="pager">
        {prev && <a class="prev" href={`/docs/${prev.id}`}>← {prev.data.title}</a>}
        {next && <a class="next" href={`/docs/${next.id}`}>{next.data.title} →</a>}
      </div>
    </article>
  </div>
</Base>
